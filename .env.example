# Copier ce fichier en .env puis remplir

# Token donné par @BotFather sur Telegram
TELEGRAM_TOKEN=

# WhatsApp (Twilio) : console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Adresse https donnée par ngrok (sans / à la fin)
PUBLIC_URL=

# IA pour reformuler les réponses (laisser vide = réponses tirées directement des documents)
# Exemple Groq (gratuit) : créer une clé sur console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Transcription des vocaux en français : tiny / base / small / medium
WHISPER_MODEL=small

# Transcription mooré / dioula avec MMS (1 = activé, lourd et expérimental)
ACTIVER_MMS=0

# Lire à voix haute les réponses libres en français (1 = activé, nécessite internet)
ACTIVER_TTS_FR=0

# Rappel d'auto-examen tous les N jours
INTERVALLE_RAPPEL_JOURS=30
